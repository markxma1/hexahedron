void main(float2 vUV : TEXCOORD0, uniform sampler2D uSrc, uniform float2 uHalfPixel, out float4 oColor : COLOR)
{
    float2 h = uHalfPixel;
    float3 s = tex2D(uSrc, vUV + float2(-h.x * 2.0, 0.0)).rgb;
    s += tex2D(uSrc, vUV + float2(-h.x, h.y)).rgb * 2.0;
    s += tex2D(uSrc, vUV + float2(0.0, h.y * 2.0)).rgb;
    s += tex2D(uSrc, vUV + float2(h.x, h.y)).rgb * 2.0;
    s += tex2D(uSrc, vUV + float2(h.x * 2.0, 0.0)).rgb;
    s += tex2D(uSrc, vUV + float2(h.x, -h.y)).rgb * 2.0;
    s += tex2D(uSrc, vUV + float2(0.0, -h.y * 2.0)).rgb;
    s += tex2D(uSrc, vUV + float2(-h.x, -h.y)).rgb * 2.0;
    oColor = float4(s / 12.0, 1.0);
}
