float3 aces(float3 x) { return saturate((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }

void main(float2 vUV : TEXCOORD0, float4 wpos : WPOS,
          uniform sampler2D uHdr, uniform sampler2D uBloom,
          uniform float uBloomStrength, uniform float uExposure, uniform float uVignette,
          out float4 oColor : COLOR)
{
    float3 c = tex2D(uHdr, vUV).rgb + tex2D(uBloom, vUV).rgb * uBloomStrength;
    c = aces(c * uExposure);
    c = pow(c, float3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
    float2 d = vUV - 0.5;
    c *= 1.0 - uVignette * pow(dot(d, d) * 2.0, 1.3);
    float n = frac(sin(dot(wpos.xy, float2(12.9898, 78.233))) * 43758.5453);
    c += (n - 0.5) / 255.0;
    oColor = float4(c, 1.0);
}
